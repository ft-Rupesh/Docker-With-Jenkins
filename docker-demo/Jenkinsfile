pipeline {
    agent any

    stages {

        stage('Build & Test') {
            steps {
                dir('docker-demo') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean test package'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('docker-demo') {
                    sh 'docker build -t rupeshmishra/docker-demo:1.0 .'
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker push rupeshmishra/docker-demo:1.0
                        docker logout
                    '''
                }
            }
        }
    }
}